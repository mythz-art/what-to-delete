{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhatToDelete",
  "version": "2.1.0",
  "identifier": "app.wtd.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "What to Delete?",
        "width": 1220,
        "height": 800,
        "minWidth": 880,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "resizable": true,
        "backgroundColor": "#020617"
      },
      {
        "label": "terminal",
        "title": "WTD // TERMINAL",
        "url": "index.html#terminal",
        "width": 960,
        "height": 560,
        "minWidth": 560,
        "minHeight": 360,
        "visible": false,
        "decorations": false,
        "resizable": true,
        "backgroundColor": "#02060a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": ["icons/icon.ico"]
  }
}
